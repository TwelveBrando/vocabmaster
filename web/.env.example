# Connection string to your PostgreSQL database. Do not commit a real .env file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vocabmaster
# Generate a random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# URL of the browser client in development. Comma-separate several URLs if needed.
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
